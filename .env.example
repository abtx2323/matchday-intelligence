# Copy to .env (never commit .env). No API keys are used: Azure auth is Entra ID
# (DefaultAzureCredential: `az login` locally, managed identity in Azure Container Apps).

# template (offline, default) | foundry | azure_openai
MDI_PROVIDER=template

# Microsoft Foundry project (MDI_PROVIDER=foundry)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-4o-mini

# Azure OpenAI (MDI_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Resilience / cost control
MDI_LLM_TIMEOUT_S=6
MDI_LLM_RETRIES=1
MDI_LLM_MIN_SIGNIFICANCE=0.7
MDI_BREAKER_THRESHOLD=3
MDI_BREAKER_COOLDOWN_S=30
MDI_MAX_STREAMS=50

# Comma-separated origins allowed by CORS (empty = same-origin only)
ALLOWED_ORIGINS=
